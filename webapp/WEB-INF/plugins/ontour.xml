<?xml version="1.0" encoding="UTF-8"?><plug-in>
    <name>ontour</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>1.0.0-SNAPSHOT</version>
    <documentation/>
    <installation/>
    <changes/>
    <user-guide/>
    <description>ontour.plugin.description</description>
    <provider>ontour.plugin.provider</provider>
    <provider-url>http://dev.lutece.paris.fr</provider-url>
    <icon-url>themes/shared/plugins/ontour/images/admin/ontour.svg</icon-url>
    <copyright>Copyright (c) 2026 Ville de Paris</copyright>
    <db-pool-required>1</db-pool-required>

    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>
    </core-version-dependency>

    <!-- Admin features parameters -->
    <admin-features>
        <admin-feature>
            <feature-id>ONTOUR_MANAGEMENT</feature-id>
            <feature-title>ontour.adminFeature.ManageTours.name</feature-title>
            <feature-description>ontour.adminFeature.ManageTours.description</feature-description>
            <feature-level>1</feature-level>
            <feature-url>jsp/admin/plugins/ontour/ManageTours.jsp</feature-url>
            <feature-icon-url>ti ti-route</feature-icon-url>
            <feature-group>SITE</feature-group>
        </admin-feature>
    </admin-features>

    <!-- RBAC: permissions on the tours (resource = tour code, shared by its translations) -->
    <rbac-resource-types>
        <rbac-resource-type>
            <rbac-resource-type-class>fr.paris.lutece.plugins.ontour.service.TourResourceIdService</rbac-resource-type-class>
        </rbac-resource-type>
    </rbac-resource-types>

    <!-- Front office: Driver.js and onTour on every page (the core prefixes these paths with css/plugins/ and js/plugins/) -->
    <css-stylesheets>
        <css-stylesheets-scope>portal</css-stylesheets-scope>
        <css-stylesheet>../../themes/shared/plugins/ontour/css/driver/driver.css</css-stylesheet>
        <css-stylesheet>../../themes/shared/plugins/ontour/css/ontour.css</css-stylesheet>
    </css-stylesheets>
    <javascript-files>
        <javascript-files-scope>portal</javascript-files-scope>
        <javascript-file>../../themes/shared/plugins/ontour/js/driver/driver.js.iife.js</javascript-file>
        <javascript-file>../../themes/shared/plugins/ontour/js/ontour.js?target=FO</javascript-file>
    </javascript-files>

    <!-- Back office: Driver.js and onTour on every admin page -->
    <admin-css-stylesheets>
        <admin-css-stylesheet>themes/shared/plugins/ontour/css/driver/driver.css</admin-css-stylesheet>
        <admin-css-stylesheet>themes/shared/plugins/ontour/css/ontour.css</admin-css-stylesheet>
    </admin-css-stylesheets>
    <admin-javascript-files>
        <admin-javascript-file>themes/shared/plugins/ontour/js/driver/driver.js.iife.js</admin-javascript-file>
        <admin-javascript-file>themes/shared/plugins/ontour/js/ontour.js?target=BO</admin-javascript-file>
    </admin-javascript-files>

    <!-- JSON endpoint read by ontour.js -->
    <servlets>
        <servlet>
            <servlet-name>OnTourServlet</servlet-name>
            <url-pattern>/servlet/plugins/ontour/tours</url-pattern>
            <servlet-class>fr.paris.lutece.plugins.ontour.web.TourServlet</servlet-class>
        </servlet>
    </servlets>
</plug-in>
